#!/usr/bin/env bash
# .githooks/pre-push — エージェント依存のない push 前ゲート
set -uo pipefail

[ "${SKIP_PUSH_GATE:-}" = "1" ] && exit 0

have_update=0
while read -r _lref lsha _rref _rsha; do
  case "$lsha" in
    0000000000000000000000000000000000000000) ;;
    *) have_update=1 ;;
  esac
done
[ "$have_update" -eq 1 ] || exit 0

repo_root="$(git rev-parse --show-toplevel)" || exit 0
cd "$repo_root" || exit 0
log="$(mktemp -t push-gate.XXXXXX)"

run_check() {
  local label="$1"; shift
  printf '\n===== %s =====\n' "$label" >>"$log"
  "$@" >>"$log" 2>&1
}

# Makefile に定義された lint と test のコマンドを実行する
failed=""
run_check "lint" make lint || failed="lint"
[ -n "$failed" ] || run_check "test" make test-all || failed="${failed:-test}"

if [ -n "$failed" ]; then
  {
    echo "push 前ゲート: ${failed} が失敗しました。修正してから push してください。"
    echo "--- 末尾40行 ---"
    tail -n 40 "$log"
    echo "全文: ${log}"
    echo "どうしても push が必要な場合のみ: SKIP_PUSH_GATE=1 git push ..."
  } >&2
  exit 1
fi
rm -f "$log"
exit 0
