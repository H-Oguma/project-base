#!/usr/bin/env bash
set -euo pipefail

MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$MSG_FILE")

# マージコミットやリバートの場合はスキップ
if [[ "$FIRST_LINE" =~ ^Merge\  ]] || [[ "$FIRST_LINE" =~ ^Revert\  ]]; then
    exit 0
fi

# 1. Conventional Commits 形式の検証
CONVENTIONAL_REGEX='^(feat|fix|chore|docs|test|refactor|ci|perf|style|build)(\([a-z0-9_,-]+\))?: .+'
if ! [[ "$FIRST_LINE" =~ $CONVENTIONAL_REGEX ]]; then
    echo "❌ [Guardrail] コミットメッセージは日本語の Conventional Commits 形式 (例: feat: 新機能の追加) で記述してください。" >&2
    echo "   プレフィックス例: feat:, fix:, chore:, docs:, test:, refactor:" >&2
    echo "   実際のメッセージ: $FIRST_LINE" >&2
    exit 1
fi

# 2. 日本語文字（ひらがな・カタカナ・漢字）が1文字以上含まれているかを判定
HAS_JAPANESE=$(python3 -c "
import re, sys
text = sys.argv[1]
if re.search(r'[\u3040-\u309F\u30A0-\u30FF\u4E00-\u9FFF]', text):
    sys.exit(0)
sys.exit(1)
" "$FIRST_LINE" 2>/dev/null && echo "1" || echo "0")

if [ "$HAS_JAPANESE" != "1" ]; then
    echo "❌ [Guardrail] コミットメッセージは日本語の Conventional Commits 形式 (例: feat: 新機能の追加) で記述してください。" >&2
    echo "   日本語文字（ひらがな・カタカナ・漢字）が含まれていません: $FIRST_LINE" >&2
    exit 1
fi

# 3. commitlint が利用可能な場合は追加検証を実行
if [ -f "node_modules/.bin/commitlint" ]; then
    npx --no -- commitlint --edit "${MSG_FILE}"
fi

exit 0
