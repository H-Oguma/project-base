{
  "workflow-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./scripts/enforce_workflow.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
