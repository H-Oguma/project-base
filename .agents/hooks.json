{
  "workflow-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./.agents/scripts/enforce_workflow.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "pr-format-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./.agents/scripts/enforce_pr_format.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
